# Copia a .env solo en tu PC. En Railway usa Variables.
DISCORD_TOKEN=
# ID del servidor: activa Modo desarrollador y Copiar ID del servidor.
GUILD_ID=
PREFIX=>
# Opcional: si falta, todo funciona salvo la IA.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_DM_ENABLED=true
REGISTER_SLASH=true
# Railway proporciona RAILWAY_VOLUME_MOUNT_PATH al conectar el volumen.
# Para ejecutar fuera de Docker, instala ffmpeg y yt-dlp y déjalos en PATH.
# FFMPEG_PATH=ffmpeg
# YTDLP_PATH=yt-dlp
# DATA_DIR=./data
